<Window x:Class="TodayWallpaper.App.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:TodayWallpaper.Core.Localization;assembly=TodayWallpaper.Core"
        Title="{x:Static loc:Strings.SETTINGS_WINDOW_TITLE}"
        Width="580" Height="520"
        MinWidth="500" MinHeight="460"
        FontFamily="Segoe UI" FontSize="13"
        Background="{DynamicResource WindowBackgroundBrush}"
        WindowStartupLocation="CenterScreen">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <TextBlock Grid.Row="0"
                   Text="{x:Static loc:Strings.SETTINGS_GROUP_HEADER}"
                   Style="{StaticResource FluentTitle}"
                   Margin="0,0,0,14"/>

        <!-- Settings Form Card -->
        <Border Grid.Row="1" Style="{StaticResource FluentCard}" Margin="0,0,0,14">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="180"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Interval -->
                    <Label Grid.Row="0" Grid.Column="0"
                           Content="{x:Static loc:Strings.SETTINGS_LABEL_INTERVAL}"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center"
                           Margin="0,0,0,16"/>
                    <Grid Grid.Row="0" Grid.Column="1" Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="65"/>
                        </Grid.ColumnDefinitions>
                        <Slider Grid.Column="0" Minimum="1" Maximum="24" TickFrequency="1"
                                IsSnapToTickEnabled="True"
                                Value="{Binding RefreshIntervalHours}"
                                VerticalAlignment="Center"/>
                        <Border Grid.Column="1"
                                Background="{DynamicResource CardHoverBackgroundBrush}"
                                BorderBrush="{DynamicResource CardBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="4"
                                Padding="6,3"
                                Margin="10,0,0,0">
                            <TextBlock Text="{Binding RefreshIntervalHours, StringFormat={}{0} h}"
                                       FontWeight="SemiBold"
                                       TextAlignment="Center"/>
                        </Border>
                    </Grid>

                    <!-- Palette Mode -->
                    <Label Grid.Row="1" Grid.Column="0"
                           Content="{x:Static loc:Strings.SETTINGS_LABEL_PALETTE}"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center"
                           Margin="0,0,0,16"/>
                    <ComboBox Grid.Row="1" Grid.Column="1"
                              Style="{StaticResource FluentComboBox}"
                              ItemsSource="{Binding PaletteModes}"
                              SelectedItem="{Binding PaletteMode}"
                              Margin="0,0,0,16"/>

                    <!-- Generator Style -->
                    <Label Grid.Row="2" Grid.Column="0"
                           Content="{x:Static loc:Strings.SETTINGS_LABEL_GENERATOR}"
                           FontWeight="SemiBold"
                           VerticalAlignment="Top"
                           Margin="0,4,0,16"/>
                    <ItemsControl Grid.Row="2" Grid.Column="1"
                                  ItemsSource="{Binding GeneratorStyleOptions}"
                                  Margin="0,4,0,16">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <CheckBox Content="{Binding DisplayName}"
                                          IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                          Margin="0,2,14,6"
                                          VerticalAlignment="Center"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- History Max Count -->
                    <Label Grid.Row="3" Grid.Column="0"
                           Content="{x:Static loc:Strings.SETTINGS_LABEL_HISTORY_MAX}"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center"
                           Margin="0,0,0,16"/>
                    <Grid Grid.Row="3" Grid.Column="1" Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="65"/>
                        </Grid.ColumnDefinitions>
                        <Slider Grid.Column="0" Minimum="10" Maximum="200" TickFrequency="10"
                                IsSnapToTickEnabled="True"
                                Value="{Binding HistoryMaxCount}"
                                VerticalAlignment="Center"/>
                        <Border Grid.Column="1"
                                Background="{DynamicResource CardHoverBackgroundBrush}"
                                BorderBrush="{DynamicResource CardBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="4"
                                Padding="6,3"
                                Margin="10,0,0,0">
                            <TextBlock Text="{Binding HistoryMaxCount}"
                                       FontWeight="SemiBold"
                                       TextAlignment="Center"/>
                        </Border>
                    </Grid>

                    <!-- Master Enable -->
                    <Label Grid.Row="4" Grid.Column="0"
                           Content="{x:Static loc:Strings.SETTINGS_LABEL_ENABLED}"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center"/>
                    <CheckBox Grid.Row="4" Grid.Column="1"
                              IsChecked="{Binding IsEnabled}"
                              VerticalAlignment="Center"/>
                </Grid>
            </ScrollViewer>
        </Border>

        <!-- Actions Bar -->
        <WrapPanel Grid.Row="2" HorizontalAlignment="Right">
            <Button Content="Cancelar"
                    Style="{StaticResource SecondaryButton}"
                    Click="CancelClick"
                    Margin="0,0,8,0"/>
            <Button Content="{x:Static loc:Strings.SETTINGS_BTN_SAVE}"
                    Style="{StaticResource PrimaryButton}"
                    Click="SaveClick"/>
        </WrapPanel>
    </Grid>
</Window>
