<Window x:Class="TodayWallpaper.App.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:TodayWallpaper.Core.Localization;assembly=TodayWallpaper.Core"
        Title="{x:Static loc:Strings.SETTINGS_WINDOW_TITLE}"
        Width="560" Height="470" ResizeMode="NoResize"
        FontFamily="Segoe UI" FontSize="12"
        WindowStartupLocation="CenterScreen">


    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="{x:Static loc:Strings.SETTINGS_GROUP_HEADER}"
                   FontSize="14" FontWeight="Bold"
                   Margin="0,0,0,12"/>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="180"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="34"/>
                <RowDefinition Height="34"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="34"/>
                <RowDefinition Height="34"/>
            </Grid.RowDefinitions>

            <Label Grid.Row="0" Grid.Column="0" Content="{x:Static loc:Strings.SETTINGS_LABEL_INTERVAL}"/>
            <Grid Grid.Row="0" Grid.Column="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="35"/>
                </Grid.ColumnDefinitions>
                <Slider Grid.Column="0" Minimum="1" Maximum="24" TickFrequency="1"
                        IsSnapToTickEnabled="True"
                        Value="{Binding RefreshIntervalHours}"/>
                <TextBlock Grid.Column="1" Text="{Binding RefreshIntervalHours}"
                           VerticalAlignment="Center" HorizontalAlignment="Right"/>
            </Grid>

            <Label Grid.Row="1" Grid.Column="0" Content="{x:Static loc:Strings.SETTINGS_LABEL_PALETTE}"/>
            <ComboBox Grid.Row="1" Grid.Column="1"
                      ItemsSource="{Binding PaletteModes}"
                      SelectedItem="{Binding PaletteMode}"/>

            <Label Grid.Row="2" Grid.Column="0" Content="{x:Static loc:Strings.SETTINGS_LABEL_GENERATOR}"
                   VerticalAlignment="Top" Margin="0,4,0,0"/>
            <ItemsControl Grid.Row="2" Grid.Column="1"
                          ItemsSource="{Binding GeneratorStyleOptions}"
                          Margin="0,4,0,6">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <CheckBox Content="{Binding DisplayName}"
                                  IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                  Margin="0,2,12,2"
                                  VerticalAlignment="Center"/>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Label Grid.Row="3" Grid.Column="0" Content="{x:Static loc:Strings.SETTINGS_LABEL_HISTORY_MAX}"/>
            <Grid Grid.Row="3" Grid.Column="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="35"/>
                </Grid.ColumnDefinitions>
                <Slider Grid.Column="0" Minimum="10" Maximum="200" TickFrequency="10"
                        IsSnapToTickEnabled="True"
                        Value="{Binding HistoryMaxCount}"/>
                <TextBlock Grid.Column="1" Text="{Binding HistoryMaxCount}"
                           VerticalAlignment="Center" HorizontalAlignment="Right"/>
            </Grid>

            <Label Grid.Row="4" Grid.Column="0" Content="{x:Static loc:Strings.SETTINGS_LABEL_ENABLED}"/>
            <CheckBox Grid.Row="4" Grid.Column="1"
                      IsChecked="{Binding IsEnabled}"
                      VerticalAlignment="Center"/>
        </Grid>

        <WrapPanel Grid.Row="2" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="{x:Static loc:Strings.SETTINGS_BTN_SAVE}" Click="SaveClick"/>
        </WrapPanel>
    </Grid>
</Window>
