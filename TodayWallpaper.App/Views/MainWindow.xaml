<Window x:Class="TodayWallpaper.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:TodayWallpaper.Core.Localization;assembly=TodayWallpaper.Core"
        Title="{x:Static loc:Strings.APP_MAIN_WINDOW_TITLE}"
        Width="980" Height="700"
        MinWidth="800" MinHeight="540"
        FontFamily="Segoe UI" FontSize="12"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Main Tab Control -->
        <TabControl Grid.Row="0" Margin="8,8,8,4">

            <!-- ══ TAB 1: Programación y Generación ══ -->
            <TabItem Header="{x:Static loc:Strings.APP_TAB_SCHEDULE}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="8">

                        <!-- Automation Schedule Group -->
                        <GroupBox Header="{x:Static loc:Strings.APP_GROUP_SCHEDULE}">
                            <StackPanel>
                                <CheckBox Content="{x:Static loc:Strings.APP_CHECK_ENABLE_SCHEDULE}"
                                          IsChecked="{Binding IsEnabled}"
                                          FontWeight="SemiBold" Margin="0,0,0,10"/>

                                <TextBlock Text="{x:Static loc:Strings.APP_LABEL_CADENCE}" FontWeight="SemiBold" Margin="0,0,0,6"/>

                                <!-- Interval mode option -->
                                <StackPanel Orientation="Horizontal" Margin="16,0,0,8" VerticalAlignment="Center">
                                    <RadioButton Content="{x:Static loc:Strings.APP_RADIO_INTERVAL}"
                                                 IsChecked="{Binding IsIntervalMode}"
                                                 IsEnabled="{Binding IsEnabled}"
                                                 GroupName="CadenceGroup"
                                                 VerticalAlignment="Center"/>
                                    <TextBox Text="{Binding RefreshIntervalHours, UpdateSourceTrigger=PropertyChanged}"
                                             IsEnabled="{Binding IsEnabled}"
                                             Width="75" Margin="8,0,8,0" TextAlignment="Left"/>
                                    <TextBlock Text="{x:Static loc:Strings.APP_TEXT_HOURS_SUFFIX}" VerticalAlignment="Center"/>
                                </StackPanel>

                                <!-- Daily fixed time option -->
                                <StackPanel Orientation="Horizontal" Margin="16,0,0,10" VerticalAlignment="Center">
                                    <RadioButton Content="{x:Static loc:Strings.APP_RADIO_DAILY}"
                                                 IsChecked="{Binding IsDailyMode}"
                                                 IsEnabled="{Binding IsEnabled}"
                                                 GroupName="CadenceGroup"
                                                 VerticalAlignment="Center"/>
                                    <TextBox Text="{Binding DailyAtHour, UpdateSourceTrigger=PropertyChanged}"
                                             IsEnabled="{Binding IsEnabled}"
                                             Width="75" Margin="8,0,4,0" TextAlignment="Left"/>
                                    <TextBlock Text=":" VerticalAlignment="Center"/>
                                    <TextBox Text="{Binding DailyAtMinute, UpdateSourceTrigger=PropertyChanged}"
                                             IsEnabled="{Binding IsEnabled}"
                                             Width="75" Margin="4,0,8,0" TextAlignment="Left"/>
                                    <TextBlock Text="{x:Static loc:Strings.APP_HINT_DAILY_FORMAT}" VerticalAlignment="Center"
                                               Foreground="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}"/>
                                </StackPanel>

                                <Separator Margin="0,4,0,8"/>

                                <!-- Run on startup if expired option -->
                                <CheckBox Content="{x:Static loc:Strings.APP_CHECK_RUN_ON_STARTUP}"
                                          IsChecked="{Binding RunOnStartupIfExpired}"
                                          IsEnabled="{Binding IsEnabled}"
                                          Margin="16,0,0,8"/>

                                <!-- Status Summary Indicator -->
                                <Border Background="{DynamicResource {x:Static SystemColors.InfoBrushKey}}"
                                        BorderBrush="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}"
                                        BorderThickness="1" Padding="8,6" Margin="0,6,0,0">
                                    <StackPanel>
                                        <TextBlock FontWeight="SemiBold"
                                                   Foreground="{DynamicResource {x:Static SystemColors.InfoTextBrushKey}}"
                                                   Text="{Binding ScheduleStatusSummary}"/>
                                        <TextBlock TextWrapping="Wrap" Margin="0,2,0,0"
                                                   Foreground="{DynamicResource {x:Static SystemColors.InfoTextBrushKey}}">
                                            <Run Text="{x:Static loc:Strings.APP_LABEL_LAST_GEN_PREFIX}"/>
                                            <Run Text="{Binding LastGenerationText, Mode=OneWay}"/>
                                        </TextBlock>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </GroupBox>

                        <!-- Generator & Visual Style Group -->
                        <GroupBox Header="{x:Static loc:Strings.APP_GROUP_VISUAL_STYLE}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="180"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="34"/>
                                    <RowDefinition Height="34"/>
                                </Grid.RowDefinitions>

                                <Label Grid.Row="0" Grid.Column="0" Content="{x:Static loc:Strings.APP_LABEL_GENERATOR_STYLE}"
                                       VerticalAlignment="Top" Margin="0,4,0,0"/>
                                <ItemsControl Grid.Row="0" Grid.Column="1"
                                              ItemsSource="{Binding GeneratorStyleOptions}"
                                              Margin="0,4,0,8">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel Orientation="Horizontal"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <CheckBox Content="{Binding DisplayName}"
                                                      IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                      Margin="0,4,16,4"
                                                      VerticalAlignment="Center"/>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <Label Grid.Row="1" Grid.Column="0" Content="{x:Static loc:Strings.APP_LABEL_PALETTE_MODE}"/>
                                <ComboBox Grid.Row="1" Grid.Column="1"
                                          ItemsSource="{Binding PaletteModes}"
                                          SelectedItem="{Binding PaletteMode}"
                                          VerticalAlignment="Center"/>

                                <Label Grid.Row="2" Grid.Column="0" Content="{x:Static loc:Strings.APP_LABEL_HISTORY_MAX}"/>
                                <Grid Grid.Row="2" Grid.Column="1">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="45"/>
                                    </Grid.ColumnDefinitions>
                                    <Slider Grid.Column="0" Minimum="10" Maximum="200" TickFrequency="10"
                                            IsSnapToTickEnabled="True"
                                            Value="{Binding HistoryMaxCount}"
                                            VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" Text="{Binding HistoryMaxCount}"
                                               VerticalAlignment="Center" HorizontalAlignment="Right"/>
                                </Grid>
                            </Grid>
                        </GroupBox>

                        <!-- Actions Bar -->
                        <WrapPanel HorizontalAlignment="Right" Margin="0,8,0,0">
                            <Button Content="{x:Static loc:Strings.APP_BTN_GENERATE_NOW}"
                                    Click="GenerateNowClick"/>
                        </WrapPanel>

                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ══ TAB 2: Ubicación y Clima ══ -->
            <TabItem Header="{x:Static loc:Strings.APP_TAB_LOCATION_WEATHER}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="8">

                        <!-- Location Configuration Group -->
                        <GroupBox Header="{x:Static loc:Strings.APP_GROUP_LOCATION}">
                            <StackPanel>
                                <RadioButton Content="{x:Static loc:Strings.APP_RADIO_AUTO_LOCATION}"
                                             IsChecked="{Binding IsAutoLocation}"
                                             GroupName="LocationModeGroup"
                                             Margin="0,0,0,4"/>
                                <TextBlock TextWrapping="Wrap" Margin="20,0,0,10"
                                           Foreground="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}">
                                    <Run Text="{x:Static loc:Strings.APP_LABEL_DETECTED_IP_PREFIX}"/>
                                    <Run Text="{Binding DetectedLocationText, Mode=OneWay}" FontWeight="SemiBold"/>
                                </TextBlock>

                                <RadioButton Content="{x:Static loc:Strings.APP_RADIO_MANUAL_LOCATION}"
                                             IsChecked="{Binding IsManualLocation}"
                                             GroupName="LocationModeGroup"
                                             Margin="0,0,0,8"/>

                                <Grid Margin="20,0,0,10" IsEnabled="{Binding IsManualLocation}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="100"/>
                                        <ColumnDefinition Width="140"/>
                                        <ColumnDefinition Width="20"/>
                                        <ColumnDefinition Width="100"/>
                                        <ColumnDefinition Width="140"/>
                                        <ColumnDefinition Width="20"/>
                                        <ColumnDefinition Width="80"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <Label Grid.Column="0" Content="{x:Static loc:Strings.APP_LABEL_LATITUDE}"/>
                                    <TextBox Grid.Column="1" Text="{Binding ManualLatitude, UpdateSourceTrigger=PropertyChanged}"/>

                                    <Label Grid.Column="3" Content="{x:Static loc:Strings.APP_LABEL_LONGITUDE}"/>
                                    <TextBox Grid.Column="4" Text="{Binding ManualLongitude, UpdateSourceTrigger=PropertyChanged}"/>

                                    <Label Grid.Column="6" Content="{x:Static loc:Strings.APP_LABEL_CITY}"/>
                                    <TextBox Grid.Column="7" Text="{Binding ManualCity, UpdateSourceTrigger=PropertyChanged}"/>
                                </Grid>

                                <WrapPanel HorizontalAlignment="Right" Margin="0,4,0,0">
                                    <Button Content="{x:Static loc:Strings.APP_BTN_DETECT_IP}"
                                            Click="DetectLocationClick"/>
                                </WrapPanel>
                            </StackPanel>
                        </GroupBox>

                        <!-- Weather Summary Group -->
                        <GroupBox Header="{x:Static loc:Strings.APP_GROUP_WEATHER_DATA}">
                            <StackPanel>
                                <Grid Margin="0,4,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="140"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="140"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="26"/>
                                        <RowDefinition Height="26"/>
                                        <RowDefinition Height="26"/>
                                        <RowDefinition Height="26"/>
                                    </Grid.RowDefinitions>

                                    <Label Grid.Row="0" Grid.Column="0" Content="{x:Static loc:Strings.APP_LABEL_WEATHER_LOCATION}" FontWeight="SemiBold"/>
                                    <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding WeatherSummaryTitle}" VerticalAlignment="Center"/>

                                    <Label Grid.Row="0" Grid.Column="2" Content="{x:Static loc:Strings.APP_LABEL_WEATHER_CONDITION}" FontWeight="SemiBold"/>
                                    <TextBlock Grid.Row="0" Grid.Column="3" Text="{Binding WeatherConditionText}" VerticalAlignment="Center"/>

                                    <Label Grid.Row="1" Grid.Column="0" Content="{x:Static loc:Strings.APP_LABEL_WEATHER_TEMP}" FontWeight="SemiBold"/>
                                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding WeatherTemperatureText}" VerticalAlignment="Center"/>

                                    <Label Grid.Row="1" Grid.Column="2" Content="{x:Static loc:Strings.APP_LABEL_WEATHER_WIND}" FontWeight="SemiBold"/>
                                    <TextBlock Grid.Row="1" Grid.Column="3" Text="{Binding WeatherWindText}" VerticalAlignment="Center"/>

                                    <Label Grid.Row="2" Grid.Column="0" Content="{x:Static loc:Strings.APP_LABEL_WEATHER_HUMIDITY}" FontWeight="SemiBold"/>
                                    <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding WeatherHumidityText}" VerticalAlignment="Center"/>

                                    <Label Grid.Row="2" Grid.Column="2" Content="{x:Static loc:Strings.APP_LABEL_WEATHER_CLOUDS}" FontWeight="SemiBold"/>
                                    <TextBlock Grid.Row="2" Grid.Column="3" Text="{Binding WeatherCloudCoverText}" VerticalAlignment="Center"/>

                                    <Label Grid.Row="3" Grid.Column="0" Content="{x:Static loc:Strings.APP_LABEL_WEATHER_PRECIP}" FontWeight="SemiBold"/>
                                    <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding WeatherPrecipitationText}" VerticalAlignment="Center"/>

                                    <Label Grid.Row="3" Grid.Column="2" Content="{x:Static loc:Strings.APP_LABEL_WEATHER_VISIBILITY}" FontWeight="SemiBold"/>
                                    <TextBlock Grid.Row="3" Grid.Column="3" Text="{Binding WeatherVisibilityText}" VerticalAlignment="Center"/>
                                </Grid>

                                <WrapPanel HorizontalAlignment="Right" Margin="0,4,0,0">
                                    <Button Content="{x:Static loc:Strings.APP_BTN_REFRESH_WEATHER}"
                                            Click="RefreshWeatherClick"/>
                                </WrapPanel>
                            </StackPanel>
                        </GroupBox>

                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ══ TAB 3: Historial de Wallpapers ══ -->
            <TabItem Header="{x:Static loc:Strings.APP_TAB_HISTORY}">
                <Grid Margin="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="380" MinWidth="260"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- History List -->
                    <GroupBox Grid.Column="0" Header="{x:Static loc:Strings.APP_GROUP_HISTORY_LIST}" Margin="0,0,8,0">
                        <ListView ItemsSource="{Binding HistoryItems}"
                                  SelectedItem="{Binding SelectedHistoryItem}"
                                  Background="{DynamicResource {x:Static SystemColors.WindowBrushKey}}"
                                  Foreground="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}"
                                  ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="4,3">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="54"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Mini thumbnail -->
                                        <Border Grid.Column="0" Width="48" Height="30"
                                                BorderBrush="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}"
                                                BorderThickness="1" Background="{DynamicResource {x:Static SystemColors.AppWorkspaceBrushKey}}"
                                                Margin="0,0,6,0">
                                            <Image Source="{Binding Thumbnail}" Stretch="UniformToFill"/>
                                        </Border>

                                        <!-- Info -->
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding DisplayTitle}" FontWeight="SemiBold"/>
                                            <TextBlock Text="{Binding DisplaySubtitle}"
                                                       Foreground="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}"
                                                       FontSize="11"/>
                                        </StackPanel>

                                        <!-- Pin Badge -->
                                        <TextBlock Grid.Column="2" Text="📌"
                                                   Visibility="{Binding Pinned, Converter={StaticResource BoolToVis}}"
                                                   VerticalAlignment="Center" Margin="4,0,0,0"/>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </GroupBox>

                    <!-- Selected Wallpaper Details & Preview -->
                    <GroupBox Grid.Column="1" Header="{x:Static loc:Strings.APP_GROUP_HISTORY_DETAILS}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- Preview container -->
                            <Border Grid.Row="0"
                                    BorderBrush="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}"
                                    BorderThickness="1"
                                    Background="{DynamicResource {x:Static SystemColors.AppWorkspaceBrushKey}}"
                                    Margin="0,0,0,8">
                                <Grid>
                                    <Image Source="{Binding SelectedHistoryItem.Thumbnail}" Stretch="Uniform"
                                           RenderOptions.BitmapScalingMode="HighQuality"/>

                                    <TextBlock Text="{x:Static loc:Strings.APP_HINT_HISTORY_EMPTY}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"
                                               Foreground="White" FontSize="14">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding HasSelectedHistoryItem}" Value="False">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Grid>
                            </Border>

                            <!-- Metadata details -->
                            <StackPanel Grid.Row="1" Margin="0,0,0,8" IsEnabled="{Binding HasSelectedHistoryItem}">
                                <TextBlock FontWeight="SemiBold" FontSize="13" Text="{Binding SelectedHistoryItem.DisplayTitle}"/>
                                <TextBlock Text="{Binding SelectedHistoryItem.DisplaySubtitle}"
                                           Foreground="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}"/>
                            </StackPanel>

                            <!-- Wallpaper Action Buttons -->
                            <WrapPanel Grid.Row="2" HorizontalAlignment="Right" IsEnabled="{Binding HasSelectedHistoryItem}">
                                <Button Content="{x:Static loc:Strings.APP_BTN_HISTORY_APPLY}"
                                        Click="ApplyClick"
                                        Margin="0,0,8,0"/>
                                <Button Content="{x:Static loc:Strings.APP_BTN_HISTORY_PIN}"
                                        Click="PinClick"
                                        Margin="0,0,8,0"/>
                                <Button Content="{x:Static loc:Strings.APP_BTN_HISTORY_VIEW_FILE}"
                                        Click="OpenViewerClick"
                                        Margin="0,0,8,0"/>
                                <Button Content="{x:Static loc:Strings.APP_BTN_HISTORY_DELETE}"
                                        Click="DeleteClick"/>
                            </WrapPanel>
                        </Grid>
                    </GroupBox>
                </Grid>
            </TabItem>

            <!-- ══ TAB 4: Paletas de Colores ══ -->
            <TabItem Header="{x:Static loc:Strings.APP_TAB_PALETTES}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="10">

                        <!-- Main Configuration & Palette Selector Group -->
                        <GroupBox Header="{x:Static loc:Strings.APP_GROUP_PALETTE_CONFIG}" Margin="0,0,0,10">
                            <StackPanel Margin="4">
                                <TextBlock Text="{x:Static loc:Strings.APP_PALETTE_DESCRIPTION}"
                                           TextWrapping="Wrap" Margin="0,0,0,12"
                                           Foreground="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}"/>

                                <!-- Row 1: Mode & Condition Selectors -->
                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="220"/>
                                        <ColumnDefinition Width="20"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="220"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <Label Grid.Column="0" Content="{x:Static loc:Strings.APP_LABEL_EDIT_MODE}"
                                           FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                    <ComboBox Grid.Column="1"
                                              ItemsSource="{Binding PaletteModeOptions}"
                                              SelectedItem="{Binding SelectedPaletteEditModeOption}"
                                              DisplayMemberPath="DisplayName"
                                              VerticalAlignment="Center" Padding="6,4"/>

                                    <Label Grid.Column="3" Content="{x:Static loc:Strings.APP_LABEL_SELECT_CONDITION}"
                                           FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                    <ComboBox Grid.Column="4"
                                              ItemsSource="{Binding WeatherConditionOptions}"
                                              SelectedItem="{Binding SelectedPaletteWeatherConditionOption}"
                                              DisplayMemberPath="FullTitle"
                                              VerticalAlignment="Center" Padding="6,4"/>
                                </Grid>

                                <!-- Row 2: Palette Selection & Management Bar -->
                                <Border Background="{DynamicResource {x:Static SystemColors.ControlLightBrushKey}}"
                                        BorderBrush="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}"
                                        BorderThickness="1" CornerRadius="4" Padding="10,8" Margin="0,0,0,4">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="200"/>
                                            <ColumnDefinition Width="16"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="180"/>
                                            <ColumnDefinition Width="16"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Palette Selector -->
                                        <Label Grid.Column="0" Content="{x:Static loc:Strings.APP_LABEL_PALETTE_SELECT}"
                                               FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                        <ComboBox Grid.Column="1"
                                                  ItemsSource="{Binding ActivePalettes}"
                                                  SelectedItem="{Binding SelectedPalette}"
                                                  DisplayMemberPath="DisplayName"
                                                  VerticalAlignment="Center" Padding="6,4"/>

                                        <!-- Palette Name Input -->
                                        <Label Grid.Column="3" Content="{x:Static loc:Strings.APP_LABEL_PALETTE_NAME}"
                                               VerticalAlignment="Center" Margin="0,0,4,0"/>
                                        <TextBox Grid.Column="4"
                                                 Text="{Binding SelectedPalette.Name, UpdateSourceTrigger=PropertyChanged}"
                                                 VerticalAlignment="Center" FontSize="12" Padding="6,3"
                                                 IsEnabled="{Binding HasSelectedPalette}"/>

                                        <!-- Enabled CheckBox -->
                                        <CheckBox Grid.Column="6"
                                                  Content="{x:Static loc:Strings.APP_CHECK_PALETTE_ENABLED}"
                                                  IsChecked="{Binding SelectedPalette.IsEnabled}"
                                                  VerticalAlignment="Center" FontWeight="SemiBold"
                                                  IsEnabled="{Binding HasSelectedPalette}"/>

                                        <!-- Palette Action Buttons -->
                                        <StackPanel Grid.Column="8" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Button Content="{x:Static loc:Strings.APP_BTN_NEW_PALETTE}"
                                                    Click="NewPaletteClick" Padding="8,4" Margin="0,0,6,0"/>
                                            <Button Content="{x:Static loc:Strings.APP_BTN_DUPLICATE_PALETTE}"
                                                    Click="DuplicatePaletteClick" Padding="8,4" Margin="0,0,6,0"
                                                    IsEnabled="{Binding HasSelectedPalette}"/>
                                            <Button Content="{x:Static loc:Strings.APP_BTN_DELETE_PALETTE}"
                                                    Click="DeletePaletteClick" Padding="8,4"
                                                    Foreground="#C9302C"
                                                    IsEnabled="{Binding CanDeletePalette}"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>

                            </StackPanel>
                        </GroupBox>

                        <!-- Drag & Drop Hint -->
                        <TextBlock Text="{x:Static loc:Strings.APP_HINT_DRAG_DROP}"
                                   Foreground="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}"
                                   FontSize="11" Margin="2,0,0,6"/>

                        <!-- Primary & Secondary Color Columns -->
                        <Grid Margin="0,0,0,10" IsEnabled="{Binding HasSelectedPalette}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Primary Colors Group (Left Column) -->
                            <GroupBox Grid.Column="0" Header="{x:Static loc:Strings.APP_GROUP_PRIMARY_COLORS}">
                                <Border x:Name="PrimaryDropZone"
                                        AllowDrop="True"
                                        Drop="ColorDropZone_Drop"
                                        DragOver="ColorDropZone_DragOver"
                                        Background="Transparent"
                                        Padding="4">
                                    <StackPanel>
                                        <ItemsControl ItemsSource="{Binding SelectedPalette.PrimaryColors}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Background="{DynamicResource {x:Static SystemColors.ControlLightLightBrushKey}}"
                                                            BorderBrush="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}"
                                                            BorderThickness="1" CornerRadius="4"
                                                            Margin="0,3" Padding="6,4"
                                                            PreviewMouseDown="ColorItem_PreviewMouseDown"
                                                            MouseMove="ColorItem_MouseMove"
                                                            Tag="{Binding}">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto"/>
                                                                <ColumnDefinition Width="34"/>
                                                                <ColumnDefinition Width="90"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>

                                                            <!-- Drag Handle -->
                                                            <TextBlock Grid.Column="0" Text="⠿" FontSize="14"
                                                                       Foreground="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}"
                                                                       VerticalAlignment="Center" Margin="0,0,6,0"
                                                                       Cursor="SizeAll" ToolTip="Arrastra para mover entre columnas"/>

                                                            <!-- Swatch Preview (clickable) -->
                                                            <Border Grid.Column="1" Width="28" Height="26"
                                                                    Background="{Binding Brush}"
                                                                    BorderBrush="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}"
                                                                    BorderThickness="1.5" CornerRadius="3"
                                                                    Cursor="Hand" ToolTip="{x:Static loc:Strings.APP_BTN_PICK_COLOR}"
                                                                    MouseDown="SwatchPreview_MouseDown" Tag="{Binding}"
                                                                    HorizontalAlignment="Left" VerticalAlignment="Center"/>

                                                            <!-- Hex Editor -->
                                                            <TextBox Grid.Column="2" Text="{Binding Hex, UpdateSourceTrigger=PropertyChanged}"
                                                                     FontFamily="Consolas" FontSize="13" FontWeight="SemiBold"
                                                                     VerticalAlignment="Center" HorizontalContentAlignment="Center"
                                                                     Padding="4,3" Margin="4,0,4,0"/>

                                                            <!-- Pick Color Button -->
                                                            <Button Grid.Column="3" Content="🎨" ToolTip="{x:Static loc:Strings.APP_BTN_PICK_COLOR}"
                                                                    Click="PickColorClick" Tag="{Binding}"
                                                                    Padding="6,3" Margin="0,0,6,0" VerticalAlignment="Center"/>

                                                            <!-- Luminance Feedback -->
                                                            <TextBlock Grid.Column="4" Text="{Binding LuminanceFeedback}"
                                                                       VerticalAlignment="Center" FontSize="11" Margin="2,0,4,0"
                                                                       TextTrimming="CharacterEllipsis">
                                                                <TextBlock.Style>
                                                                    <Style TargetType="TextBlock">
                                                                        <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}"/>
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding IsLuminanceAcceptable}" Value="False">
                                                                                <Setter Property="Foreground" Value="#D97706"/>
                                                                                <Setter Property="FontWeight" Value="SemiBold"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </TextBlock.Style>
                                                            </TextBlock>

                                                            <!-- Remove Button -->
                                                            <Button Grid.Column="5" Content="✕" ToolTip="{x:Static loc:Strings.APP_BTN_REMOVE_COLOR}"
                                                                    IsEnabled="{Binding CanRemove}"
                                                                    Click="RemovePrimaryColorClick" Tag="{Binding}"
                                                                    Padding="8,2" VerticalAlignment="Center"
                                                                    FontWeight="Bold" Foreground="#C9302C"/>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>

                                        <!-- Add Color Button -->
                                        <Button Content="{x:Static loc:Strings.APP_BTN_ADD_COLOR}"
                                                Click="AddPrimaryColorClick"
                                                HorizontalAlignment="Left" Margin="0,8,0,0" Padding="14,4"/>
                                    </StackPanel>
                                </Border>
                            </GroupBox>

                            <!-- Secondary Colors Group (Right Column) -->
                            <GroupBox Grid.Column="2" Header="{x:Static loc:Strings.APP_GROUP_SECONDARY_COLORS}">
                                <Border x:Name="SecondaryDropZone"
                                        AllowDrop="True"
                                        Drop="ColorDropZone_Drop"
                                        DragOver="ColorDropZone_DragOver"
                                        Background="Transparent"
                                        Padding="4">
                                    <StackPanel>
                                        <ItemsControl ItemsSource="{Binding SelectedPalette.SecondaryColors}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Background="{DynamicResource {x:Static SystemColors.ControlLightLightBrushKey}}"
                                                            BorderBrush="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}"
                                                            BorderThickness="1" CornerRadius="4"
                                                            Margin="0,3" Padding="6,4"
                                                            PreviewMouseDown="ColorItem_PreviewMouseDown"
                                                            MouseMove="ColorItem_MouseMove"
                                                            Tag="{Binding}">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto"/>
                                                                <ColumnDefinition Width="34"/>
                                                                <ColumnDefinition Width="90"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>

                                                            <!-- Drag Handle -->
                                                            <TextBlock Grid.Column="0" Text="⠿" FontSize="14"
                                                                       Foreground="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}"
                                                                       VerticalAlignment="Center" Margin="0,0,6,0"
                                                                       Cursor="SizeAll" ToolTip="Arrastra para mover entre columnas"/>

                                                            <!-- Swatch Preview (clickable) -->
                                                            <Border Grid.Column="1" Width="28" Height="26"
                                                                    Background="{Binding Brush}"
                                                                    BorderBrush="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}"
                                                                    BorderThickness="1.5" CornerRadius="3"
                                                                    Cursor="Hand" ToolTip="{x:Static loc:Strings.APP_BTN_PICK_COLOR}"
                                                                    MouseDown="SwatchPreview_MouseDown" Tag="{Binding}"
                                                                    HorizontalAlignment="Left" VerticalAlignment="Center"/>

                                                            <!-- Hex Editor -->
                                                            <TextBox Grid.Column="2" Text="{Binding Hex, UpdateSourceTrigger=PropertyChanged}"
                                                                     FontFamily="Consolas" FontSize="13" FontWeight="SemiBold"
                                                                     VerticalAlignment="Center" HorizontalContentAlignment="Center"
                                                                     Padding="4,3" Margin="4,0,4,0"/>

                                                            <!-- Pick Color Button -->
                                                            <Button Grid.Column="3" Content="🎨" ToolTip="{x:Static loc:Strings.APP_BTN_PICK_COLOR}"
                                                                    Click="PickColorClick" Tag="{Binding}"
                                                                    Padding="6,3" Margin="0,0,6,0" VerticalAlignment="Center"/>

                                                            <!-- Luminance Feedback -->
                                                            <TextBlock Grid.Column="4" Text="{Binding LuminanceFeedback}"
                                                                       VerticalAlignment="Center" FontSize="11" Margin="2,0,4,0"
                                                                       TextTrimming="CharacterEllipsis">
                                                                <TextBlock.Style>
                                                                    <Style TargetType="TextBlock">
                                                                        <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}"/>
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding IsLuminanceAcceptable}" Value="False">
                                                                                <Setter Property="Foreground" Value="#D97706"/>
                                                                                <Setter Property="FontWeight" Value="SemiBold"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </TextBlock.Style>
                                                            </TextBlock>

                                                            <!-- Remove Button -->
                                                            <Button Grid.Column="5" Content="✕" ToolTip="{x:Static loc:Strings.APP_BTN_REMOVE_COLOR}"
                                                                    IsEnabled="{Binding CanRemove}"
                                                                    Click="RemoveSecondaryColorClick" Tag="{Binding}"
                                                                    Padding="8,2" VerticalAlignment="Center"
                                                                    FontWeight="Bold" Foreground="#C9302C"/>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>

                                        <!-- Add Color Button -->
                                        <Button Content="{x:Static loc:Strings.APP_BTN_ADD_COLOR}"
                                                Click="AddSecondaryColorClick"
                                                HorizontalAlignment="Left" Margin="0,8,0,0" Padding="14,4"/>
                                    </StackPanel>
                                </Border>
                            </GroupBox>
                        </Grid>

                        <!-- Palette Preview Strip Group -->
                        <GroupBox Header="{x:Static loc:Strings.APP_GROUP_PALETTE_PREVIEW}" Margin="0,0,0,10">
                            <StackPanel Margin="4">
                                <ItemsControl ItemsSource="{Binding SelectedPalette.PreviewBrushes}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <UniformGrid Rows="1" Height="30"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="{Binding}"
                                                    BorderBrush="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}"
                                                    BorderThickness="0.5"/>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <!-- Informative notice about recommended luminance -->
                                <TextBlock Text="{x:Static loc:Strings.APP_PALETTE_LUMINANCE_RECOMMENDATION}"
                                           Foreground="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}"
                                           FontSize="11" Margin="0,6,0,0"/>

                                <!-- Warning info message if invalid hex format -->
                                <TextBlock Text="{Binding SelectedPalette.ValidationMessage}"
                                           Foreground="#D9534F" FontWeight="SemiBold"
                                           Margin="0,4,0,0" TextWrapping="Wrap"
                                           Visibility="{Binding SelectedPalette.HasValidationErrors, Converter={StaticResource BoolToVis}}"/>
                            </StackPanel>
                        </GroupBox>

                        <!-- Actions Bar -->
                        <WrapPanel HorizontalAlignment="Right" Margin="0,0,0,4">
                            <Button Content="{x:Static loc:Strings.APP_BTN_RESET_CONDITION}"
                                    Click="ResetConditionClick"
                                    Margin="0,0,8,0" Padding="10,4"/>
                            <Button Content="{x:Static loc:Strings.APP_BTN_RESET_ALL_PALETTES}"
                                    Click="ResetAllPalettesClick"
                                    Margin="0,0,8,0" Padding="10,4"/>
                            <Button Content="{x:Static loc:Strings.APP_BTN_GENERATE_NOW}"
                                    Click="GenerateNowClick" Padding="12,4"/>
                        </WrapPanel>

                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <!-- Native Status Bar -->
        <StatusBar Grid.Row="1">
            <StatusBarItem>
                <TextBlock Text="{Binding StatusMessage}" VerticalAlignment="Center"/>
            </StatusBarItem>
            <StatusBarItem HorizontalAlignment="Right">
                <TextBlock Text="{Binding ScheduleStatusSummary}"
                           Foreground="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}"
                           VerticalAlignment="Center"/>
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>
