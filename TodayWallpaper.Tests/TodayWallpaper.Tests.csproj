    <PackageReference Include="coverlet.collector" Version="6.*" />
    <PackageReference Include="Microsoft.Extensions.Http" Version="10.*" />
    <PackageReference Include="Moq" Version="4.*" />
    <PackageReference Include="SkiaSharp" Version="2.*" />
    <PackageReference Include="SkiaSharp.NativeAssets.Win32" Version="2.*" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\TodayWallpaper.Core\TodayWallpaper.Core.csproj" />
    <ProjectReference Include="..\TodayWallpaper.Worker\TodayWallpaper.Worker.csproj" />
    <ProjectReference Include="..\TodayWallpaper.App\TodayWallpaper.App.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="UnitTest1.cs" />
  </ItemGroup>

