<Window x:Class="TodayWallpaper.Sandbox.SandboxWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:TodayWallpaper.Core.Localization;assembly=TodayWallpaper.Core"
        Title="{x:Static loc:Strings.SANDBOX_WINDOW_TITLE}"
        Width="1140" Height="740"
        MinWidth="880" MinHeight="580"
        FontFamily="Segoe UI" FontSize="13"
        Background="{DynamicResource WindowBackgroundBrush}"
        WindowStartupLocation="CenterScreen">

    <Grid Margin="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="340" MinWidth="280"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ══ LEFT PANEL: Controls ══ -->
        <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" Margin="0,0,14,0" Padding="0,0,4,0">
            <StackPanel>
                <!-- Generation Settings Card -->
                <Border Style="{StaticResource FluentCard}">
                    <StackPanel>
                        <TextBlock Text="{x:Static loc:Strings.SANDBOX_GROUP_GENERATOR}"
                                   Style="{StaticResource FluentSectionHeader}"/>

                        <Grid Margin="0,4,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="100"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <Label Grid.Row="0" Grid.Column="0"
                                   Content="{x:Static loc:Strings.SANDBOX_LABEL_CONDITION}"
                                   VerticalAlignment="Center"
                                   Margin="0,0,0,8"/>
                            <ComboBox Grid.Row="0" Grid.Column="1"
                                      Style="{StaticResource FluentComboBox}"
                                      ItemsSource="{Binding Conditions}"
                                      SelectedItem="{Binding Condition}"
                                      Margin="0,0,0,8"/>

                            <Label Grid.Row="1" Grid.Column="0"
                                   Content="{x:Static loc:Strings.SANDBOX_LABEL_STYLE}"
                                   VerticalAlignment="Center"
                                   Margin="0,0,0,8"/>
                            <ComboBox Grid.Row="1" Grid.Column="1"
                                      Style="{StaticResource FluentComboBox}"
                                      ItemsSource="{Binding Styles}"
                                      SelectedValue="{Binding StyleId}"
                                      SelectedValuePath="StyleId"
                                      DisplayMemberPath="DisplayName"
                                      Margin="0,0,0,8"/>

                            <Label Grid.Row="2" Grid.Column="0"
                                   Content="{x:Static loc:Strings.SANDBOX_LABEL_PALETTE}"
                                   VerticalAlignment="Center"/>
                            <ComboBox Grid.Row="2" Grid.Column="1"
                                      Style="{StaticResource FluentComboBox}"
                                      ItemsSource="{Binding Modes}"
                                      SelectedItem="{Binding Mode}"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Weather Sliders Card -->
                <Border Style="{StaticResource FluentCard}">
                    <StackPanel>
                        <TextBlock Text="{x:Static loc:Strings.SANDBOX_GROUP_WEATHER}"
                                   Style="{StaticResource FluentSectionHeader}"/>

                        <!-- WMO Code -->
                        <Label Content="{x:Static loc:Strings.SANDBOX_LABEL_WMO}" FontWeight="SemiBold" Margin="0,4,0,0"/>
                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Slider Grid.Column="0" Minimum="0" Maximum="99" Value="{Binding WmoCode}"
                                    TickFrequency="1" IsSnapToTickEnabled="True" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" Text="{Binding WmoCode}" Style="{StaticResource ValueLabel}"/>
                        </Grid>

                        <!-- Temperature -->
                        <Label Content="{x:Static loc:Strings.SANDBOX_LABEL_TEMP}" FontWeight="SemiBold"/>
                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Slider Grid.Column="0" Minimum="-30" Maximum="50" Value="{Binding Temperature}" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" Text="{Binding Temperature, StringFormat={}{0:F1}°C}" Style="{StaticResource ValueLabel}"/>
                        </Grid>

                        <!-- Apparent Temperature -->
                        <Label Content="{x:Static loc:Strings.SANDBOX_LABEL_APPARENT_TEMP}" FontWeight="SemiBold"/>
                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Slider Grid.Column="0" Minimum="-30" Maximum="50" Value="{Binding ApparentTemp}" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" Text="{Binding ApparentTemp, StringFormat={}{0:F1}°C}" Style="{StaticResource ValueLabel}"/>
                        </Grid>

                        <!-- Windspeed -->
                        <Label Content="{x:Static loc:Strings.SANDBOX_LABEL_WIND}" FontWeight="SemiBold"/>
                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Slider Grid.Column="0" Minimum="0" Maximum="150" Value="{Binding Windspeed}" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" Text="{Binding Windspeed, StringFormat={}{0:F0} km/h}" Style="{StaticResource ValueLabel}"/>
                        </Grid>

                        <!-- Humidity -->
                        <Label Content="{x:Static loc:Strings.SANDBOX_LABEL_HUMIDITY}" FontWeight="SemiBold"/>
                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Slider Grid.Column="0" Minimum="0" Maximum="100" Value="{Binding Humidity}" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" Text="{Binding Humidity, StringFormat={}{0:F0}%}" Style="{StaticResource ValueLabel}"/>
                        </Grid>

                        <!-- Precipitation -->
                        <Label Content="{x:Static loc:Strings.SANDBOX_LABEL_PRECIP}" FontWeight="SemiBold"/>
                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Slider Grid.Column="0" Minimum="0" Maximum="100" Value="{Binding Precipitation}" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" Text="{Binding Precipitation, StringFormat={}{0:F1} mm}" Style="{StaticResource ValueLabel}"/>
                        </Grid>

                        <!-- Cloud Cover -->
                        <Label Content="{x:Static loc:Strings.SANDBOX_LABEL_CLOUDS}" FontWeight="SemiBold"/>
                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Slider Grid.Column="0" Minimum="0" Maximum="100" Value="{Binding CloudCover}" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" Text="{Binding CloudCover, StringFormat={}{0:F0}%}" Style="{StaticResource ValueLabel}"/>
                        </Grid>

                        <!-- Visibility -->
                        <Label Content="{x:Static loc:Strings.SANDBOX_LABEL_VISIBILITY}" FontWeight="SemiBold"/>
                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Slider Grid.Column="0" Minimum="0" Maximum="50" Value="{Binding Visibility}" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" Text="{Binding Visibility, StringFormat={}{0:F1} km}" Style="{StaticResource ValueLabel}"/>
                        </Grid>

                        <!-- Dewpoint -->
                        <Label Content="{x:Static loc:Strings.SANDBOX_LABEL_DEWPOINT}" FontWeight="SemiBold"/>
                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Slider Grid.Column="0" Minimum="-30" Maximum="30" Value="{Binding Dewpoint}" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" Text="{Binding Dewpoint, StringFormat={}{0:F1}°C}" Style="{StaticResource ValueLabel}"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Actions Card -->
                <Border Style="{StaticResource FluentCard}">
                    <StackPanel>
                        <TextBlock Text="{x:Static loc:Strings.SANDBOX_GROUP_ACTIONS}"
                                   Style="{StaticResource FluentSectionHeader}"/>

                        <CheckBox Content="{x:Static loc:Strings.SANDBOX_CHECK_AUTO_REFRESH}"
                                  IsChecked="{Binding AutoRefresh}"
                                  FontWeight="SemiBold"
                                  Margin="0,4,0,10"/>

                        <WrapPanel Margin="0,0,0,10">
                            <Button Content="{x:Static loc:Strings.SANDBOX_BTN_RANDOMIZE}"
                                    Style="{StaticResource SecondaryButton}"
                                    Click="RandomizeClick" Margin="0,0,8,0"/>
                            <Button Content="{x:Static loc:Strings.SANDBOX_BTN_GENERATE}"
                                    Style="{StaticResource PrimaryButton}"
                                    Click="GenerateClick"/>
                        </WrapPanel>

                        <Border Background="{DynamicResource CardHoverBackgroundBrush}"
                                BorderBrush="{DynamicResource CardBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="4"
                                Padding="8,6">
                            <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}">
                                <Run Text="{x:Static loc:Strings.SANDBOX_LABEL_SEED_PREFIX}"/>
                                <Run Text="{Binding Seed, Mode=OneWay}" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                            </TextBlock>
                        </Border>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- ══ RIGHT PANEL: Preview ══ -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Preview Image Canvas Card -->
            <Border Grid.Row="0"
                    BorderBrush="{DynamicResource CardBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Background="#1A1A1A"
                    ClipToBounds="True">
                <Grid>
                    <Image Source="{Binding Preview}" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>

                    <!-- Generating overlay -->
                    <Border Background="#88000000" Visibility="{Binding IsGenerating, Converter={StaticResource BoolToVis}}">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock Text="⚙️" FontSize="28" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                            <TextBlock Text="{x:Static loc:Strings.SANDBOX_OVERLAY_GENERATING}"
                                       Foreground="White" FontSize="16" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Border>

                    <!-- Empty state -->
                    <TextBlock Text="{x:Static loc:Strings.SANDBOX_HINT_EMPTY}"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               Foreground="#88FFFFFF" FontSize="14">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Preview}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>
            </Border>

            <!-- Status Bar -->
            <Border Grid.Row="1"
                    Background="{DynamicResource CardBackgroundBrush}"
                    BorderBrush="{DynamicResource CardBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="6"
                    Padding="12,8"
                    Margin="0,10,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" VerticalAlignment="Center">
                        <Run Text="{x:Static loc:Strings.SANDBOX_STATUS_GEN_TIME_PREFIX}"/>
                        <Run Text="{Binding GenerationMs, Mode=OneWay}" FontWeight="SemiBold"/>
                        <Run Text="{x:Static loc:Strings.SANDBOX_STATUS_GEN_TIME_SUFFIX}"/>
                    </TextBlock>

                    <WrapPanel Grid.Column="1">
                        <Button Content="{x:Static loc:Strings.SANDBOX_BTN_SAVE_AS}"
                                Style="{StaticResource SecondaryButton}"
                                Click="SaveAsClick" Margin="0,0,8,0"/>
                        <Button Content="{x:Static loc:Strings.SANDBOX_BTN_APPLY}"
                                Style="{StaticResource PrimaryButton}"
                                Click="ApplyClick"/>
                    </WrapPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
