<Window x:Class="TodayWallpaper.Sandbox.SandboxWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:TodayWallpaper.Core.Localization;assembly=TodayWallpaper.Core"
        Title="{x:Static loc:Strings.SANDBOX_WINDOW_TITLE}"
        Width="1100" Height="720"
        MinWidth="850" MinHeight="550"
        FontFamily="Segoe UI" FontSize="12"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>


        <!-- Value Label Style for Slider Readouts -->
        <Style x:Key="ValueLabel" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="MinWidth" Value="42"/>
            <Setter Property="TextAlignment" Value="Right"/>
            <Setter Property="Margin" Value="4,0,0,0"/>
        </Style>
    </Window.Resources>

    <Grid Margin="8">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="320" MinWidth="260"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ══ LEFT PANEL: Controls ══ -->
        <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" Margin="0,0,8,0">
            <StackPanel>
                <!-- Generation Settings Group -->
                <GroupBox Header="{x:Static loc:Strings.SANDBOX_GROUP_GENERATOR}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="100"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="28"/>
                            <RowDefinition Height="28"/>
                            <RowDefinition Height="28"/>
                        </Grid.RowDefinitions>

                        <Label Grid.Row="0" Grid.Column="0" Content="{x:Static loc:Strings.SANDBOX_LABEL_CONDITION}"/>
                        <ComboBox Grid.Row="0" Grid.Column="1"
                                  ItemsSource="{Binding Conditions}"
                                  SelectedItem="{Binding Condition}"
                                  VerticalAlignment="Center"/>

                        <Label Grid.Row="1" Grid.Column="0" Content="{x:Static loc:Strings.SANDBOX_LABEL_STYLE}"/>
                        <ComboBox Grid.Row="1" Grid.Column="1"
                                  ItemsSource="{Binding Styles}"
                                  SelectedValue="{Binding StyleId}"
                                  SelectedValuePath="StyleId"
                                  DisplayMemberPath="DisplayName"
                                  VerticalAlignment="Center"/>

                        <Label Grid.Row="2" Grid.Column="0" Content="{x:Static loc:Strings.SANDBOX_LABEL_PALETTE}"/>
                        <ComboBox Grid.Row="2" Grid.Column="1"
                                  ItemsSource="{Binding Modes}"
                                  SelectedItem="{Binding Mode}"
                                  VerticalAlignment="Center"/>
                    </Grid>
                </GroupBox>

                <!-- Weather Sliders Group -->
                <GroupBox Header="{x:Static loc:Strings.SANDBOX_GROUP_WEATHER}">
                    <StackPanel>
                        <!-- WMO Code -->
                        <Label Content="{x:Static loc:Strings.SANDBOX_LABEL_WMO}"/>
                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Slider Grid.Column="0" Minimum="0" Maximum="99" Value="{Binding WmoCode}"
                                    TickFrequency="1" IsSnapToTickEnabled="True"/>
                            <TextBlock Grid.Column="1" Text="{Binding WmoCode}" Style="{StaticResource ValueLabel}"/>
                        </Grid>

                        <!-- Temperature -->
                        <Label Content="{x:Static loc:Strings.SANDBOX_LABEL_TEMP}"/>
                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Slider Grid.Column="0" Minimum="-30" Maximum="50" Value="{Binding Temperature}"/>
                            <TextBlock Grid.Column="1" Text="{Binding Temperature, StringFormat={}{0:F1}}" Style="{StaticResource ValueLabel}"/>
                        </Grid>

                        <!-- Apparent Temperature -->
                        <Label Content="{x:Static loc:Strings.SANDBOX_LABEL_APPARENT_TEMP}"/>
                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Slider Grid.Column="0" Minimum="-30" Maximum="50" Value="{Binding ApparentTemp}"/>
                            <TextBlock Grid.Column="1" Text="{Binding ApparentTemp, StringFormat={}{0:F1}}" Style="{StaticResource ValueLabel}"/>
                        </Grid>

                        <!-- Windspeed -->
                        <Label Content="{x:Static loc:Strings.SANDBOX_LABEL_WIND}"/>
                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Slider Grid.Column="0" Minimum="0" Maximum="150" Value="{Binding Windspeed}"/>
                            <TextBlock Grid.Column="1" Text="{Binding Windspeed, StringFormat={}{0:F0}}" Style="{StaticResource ValueLabel}"/>
                        </Grid>

                        <!-- Humidity -->
                        <Label Content="{x:Static loc:Strings.SANDBOX_LABEL_HUMIDITY}"/>
                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Slider Grid.Column="0" Minimum="0" Maximum="100" Value="{Binding Humidity}"/>
                            <TextBlock Grid.Column="1" Text="{Binding Humidity, StringFormat={}{0:F0}}" Style="{StaticResource ValueLabel}"/>
                        </Grid>

                        <!-- Precipitation -->
                        <Label Content="{x:Static loc:Strings.SANDBOX_LABEL_PRECIP}"/>
                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Slider Grid.Column="0" Minimum="0" Maximum="100" Value="{Binding Precipitation}"/>
                            <TextBlock Grid.Column="1" Text="{Binding Precipitation, StringFormat={}{0:F1}}" Style="{StaticResource ValueLabel}"/>
                        </Grid>

                        <!-- Cloud Cover -->
                        <Label Content="{x:Static loc:Strings.SANDBOX_LABEL_CLOUDS}"/>
                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Slider Grid.Column="0" Minimum="0" Maximum="100" Value="{Binding CloudCover}"/>
                            <TextBlock Grid.Column="1" Text="{Binding CloudCover, StringFormat={}{0:F0}}" Style="{StaticResource ValueLabel}"/>
                        </Grid>

                        <!-- Visibility -->
                        <Label Content="{x:Static loc:Strings.SANDBOX_LABEL_VISIBILITY}"/>
                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Slider Grid.Column="0" Minimum="0" Maximum="50" Value="{Binding Visibility}"/>
                            <TextBlock Grid.Column="1" Text="{Binding Visibility, StringFormat={}{0:F1}}" Style="{StaticResource ValueLabel}"/>
                        </Grid>

                        <!-- Dewpoint -->
                        <Label Content="{x:Static loc:Strings.SANDBOX_LABEL_DEWPOINT}"/>
                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Slider Grid.Column="0" Minimum="-30" Maximum="30" Value="{Binding Dewpoint}"/>
                            <TextBlock Grid.Column="1" Text="{Binding Dewpoint, StringFormat={}{0:F1}}" Style="{StaticResource ValueLabel}"/>
                        </Grid>
                    </StackPanel>
                </GroupBox>

                <!-- Actions Group -->
                <GroupBox Header="{x:Static loc:Strings.SANDBOX_GROUP_ACTIONS}">
                    <StackPanel>
                        <CheckBox Content="{x:Static loc:Strings.SANDBOX_CHECK_AUTO_REFRESH}"
                                  IsChecked="{Binding AutoRefresh}"
                                  Margin="0,0,0,8"/>

                        <WrapPanel Margin="0,0,0,8">
                            <Button Content="{x:Static loc:Strings.SANDBOX_BTN_RANDOMIZE}" Click="RandomizeClick" Margin="0,0,8,0"/>
                            <Button Content="{x:Static loc:Strings.SANDBOX_BTN_GENERATE}" Click="GenerateClick"/>
                        </WrapPanel>

                        <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}">
                            <Run Text="{x:Static loc:Strings.SANDBOX_LABEL_SEED_PREFIX}"/>
                            <Run Text="{Binding Seed, Mode=OneWay}" FontWeight="SemiBold"/>
                        </TextBlock>
                    </StackPanel>
                </GroupBox>
            </StackPanel>
        </ScrollViewer>

        <!-- ══ RIGHT PANEL: Preview ══ -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Preview Image Canvas -->
            <Border Grid.Row="0"
                    BorderBrush="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}"
                    BorderThickness="1"
                    Background="{DynamicResource {x:Static SystemColors.AppWorkspaceBrushKey}}">
                <Grid>
                    <Image Source="{Binding Preview}" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>

                    <!-- Generating overlay -->
                    <Border Background="#80000000" Visibility="{Binding IsGenerating, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="{x:Static loc:Strings.SANDBOX_OVERLAY_GENERATING}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Foreground="White" FontSize="16" FontWeight="SemiBold"/>
                    </Border>

                    <!-- Empty state -->
                    <TextBlock Text="{x:Static loc:Strings.SANDBOX_HINT_EMPTY}"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               Foreground="White" FontSize="14">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Preview}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>
            </Border>

            <!-- Native Status Bar -->
            <StatusBar Grid.Row="1" Margin="0,4,0,0">
                <StatusBarItem>
                    <TextBlock VerticalAlignment="Center">
                        <Run Text="{x:Static loc:Strings.SANDBOX_STATUS_GEN_TIME_PREFIX}"/>
                        <Run Text="{Binding GenerationMs, Mode=OneWay}" FontWeight="SemiBold"/>
                        <Run Text="{x:Static loc:Strings.SANDBOX_STATUS_GEN_TIME_SUFFIX}"/>
                    </TextBlock>
                </StatusBarItem>
                <StatusBarItem HorizontalAlignment="Right">
                    <WrapPanel>
                        <Button Content="{x:Static loc:Strings.SANDBOX_BTN_SAVE_AS}" Click="SaveAsClick" Margin="0,0,8,0"/>
                        <Button Content="{x:Static loc:Strings.SANDBOX_BTN_APPLY}" Click="ApplyClick"/>
                    </WrapPanel>
                </StatusBarItem>
            </StatusBar>
        </Grid>
    </Grid>
</Window>
